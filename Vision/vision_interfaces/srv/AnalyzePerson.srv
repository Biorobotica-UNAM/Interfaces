# ── REQUEST ──────────────────────────────────────────────
string action           # "color" | "attribute" | "gesture" | "combined" | "gesture_color"
string color            # "red" | "blue" | etc.         → color / combined
string attribute        # "shirt" | "jacket" | etc.     → color / combined
string gesture_type     # "pointing" | "waving" | etc.  → gesture / combined
string arm_side         # "left" | "right" | "any"      → gesture / combined
---
# ── RESPONSE ─────────────────────────────────────────────
bool   success
string message          # resultado o descripción del error
vision_interfaces/YoloDetection[] detections   # detecciones del objeto/persona encontrada
